# ─── Variables à définir dans Supabase ────────────────────────────────────────
# Dashboard > Project Settings > Edge Functions > Secrets
# (SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY sont injectées automatiquement,
#  ne pas les recréer à la main)

# Origines autorisées à appeler la fonction, séparées par des virgules.
# Sans cette variable, tout le monde peut poster : la renseigner.
ORIGINES_AUTORISEES=https://cabinet-atlas-link.netlify.app

# Secret arbitraire servant à signer les chemins de fichiers.
# Générer avec :  openssl rand -hex 32
ATLAS_SECRET=

# ─── Brevo ───────────────────────────────────────────────────────────────────
# Réutiliser la MÊME clé que VSM Connect (même compte Brevo) : le domaine
# vsmcfa.com y est déjà authentifié DKIM/DMARC, rien à toucher côté DNS.
# À recopier depuis Supabase de vsm-crm > Edge Functions > Secrets > BREVO_API_KEY,
# ou à regénérer dans Brevo > SMTP & API > API Keys.
BREVO_API_KEY=
MAIL_DESTINATAIRE=contact@vsmcfa.com
# Expéditeur déjà utilisé en production par VSM Connect. Ne le changer que pour
# une autre adresse @vsmcfa.com déclarée dans Brevo > Senders.
MAIL_EXPEDITEUR=contact@vsmcfa.com

# Bilan dans le mail : "lien" (défaut, URL signée Supabase, aucune limite de
# taille) ou "piece_jointe" (Brevo plafonne alors vers 10 Mo).
MAIL_MODE_BILAN=lien
LIEN_BILAN_JOURS=365

# Secret partagé entre pg_cron et les fonctions planifiées.
# Générer avec :  openssl rand -hex 32
CRON_SECRET=

# ─── Rétention ───────────────────────────────────────────────────────────────
# 0 = AUCUNE purge automatique. Les leads et les bilans restent en ligne
# indéfiniment (décision dirigeant). Les suppressions se font à la demande,
# à la main, depuis le Table Editor.
RETENTION_BILAN_JOURS=0
RETENTION_LEAD_JOURS=0
# Seul nettoyage actif : les fichiers envoyés dont le formulaire n'a jamais été
# validé. Sans ligne de lead, ils n'ont ni nom de garage ni contact.
ORPHELIN_JOURS=7

# Facultatif : webhook Slack / Discord / n8n recevant les alertes critiques.
ALERTE_WEBHOOK_URL=
